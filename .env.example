# Copy to .env and fill in. Never commit .env.
ODOO_MODE=live            # live | demo
ODOO_URL=https://voltride-demo.odoo.com
ODOO_DB=voltride-demo
ODOO_USER=                # Odoo login email
ODOO_API_KEY=             # avatar > My Preferences > Account Security > New API Key
ODOO_SNAPSHOT_PATH=       # demo mode only; empty = bundled backend/app/odoo/snapshot/voltride.json
DATABASE_URL=             # Neon pooled connection (filled by `neon link` / `neon deploy`)
DATABASE_URL_UNPOOLED=    # Neon direct connection, for migrations
NEON_BRANCH=
# AI assistant. LLM_PROVIDER: gemini (default, free tier) | anthropic | openai_compatible
LLM_PROVIDER=gemini
LLM_MODEL=                # empty = provider default (gemini-flash-latest / claude-opus-5-5)
GEMINI_API_KEY=           # Google AI Studio
ANTHROPIC_API_KEY=
LLM_EFFORT=               # anthropic only: low | medium | high | xhigh | max (empty = model default)
LLM_BASE_URL=             # openai_compatible only, e.g. https://router.huggingface.co/v1
LLM_API_KEY=              # openai_compatible only
DEMO_PASSWORD=            # optional gate for AI features on the public demo
